# Copy to .env and edit
API_KEY=change-me
DB_PATH=aquasense.db
MODEL_DIR=models
RETENTION_DAYS=30

# Where the device sits (used to download weather history for training)
LAT=12.97
LON=79.16
TZ_OFFSET_MIN=330

# Water analytics
PUMP_FLOW_LPM=1.0                 # litres per minute of your pump
BASELINE_PUMP_S_PER_DAY=180       # assumed fixed-schedule watering used to compute "water saved"
SOIL_TRIGGER_PCT=35               # soil % at which the system starts watering (for "hours until dry")
CORS_ORIGINS=*                    # restrict to your frontend URL in production
